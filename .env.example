# RailMentes backend settings. Copy to .env (scripts\dev_setup.ps1 does this for you). Never commit .env.
# The backend reads this file from the repo root; real environment variables win over it.
# There are no secrets in this project: every value below is a plain setting.

# Address used when the server is started with `python -m app.api.main` (run from backend\).
# start_all.bat and scripts\run_backend.ps1 start uvicorn on 127.0.0.1:8000 themselves
# (run_backend.ps1 -Port 9000 changes that; then also set VITE_API_URL, see below).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Extra browser origin allowed by CORS besides http://localhost:5173 and http://127.0.0.1:5173.
# FRONTEND_ORIGIN=http://localhost:5173

# Seed of the scenario the server starts with (the dashboard's Scenario menu can change it).
SIM_SEED=42

# Delay model: set USE_ML_MODEL=false to use the simple "delay stays as now" estimate instead.
# Train it first with scripts\train_model.py; if the file is missing the backend falls back automatically.
USE_ML_MODEL=true
# DELAY_MODEL_PATH=models/delay_model.json

# Compute the strategy KPIs (GET /kpis) in background worker processes at start-up and after every reset.
# Set to false to start them only on the first request.
PRECOMPUTE_KPIS=true

# The frontend (Vite) does NOT read this file. To point it at another backend address, copy
# frontend\.env.example to frontend\.env.local and set VITE_API_URL there (default http://localhost:8000).
